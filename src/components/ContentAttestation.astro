---
interface Props {
  casUrls?: readonly string[];
}

const { casUrls = [] } = Astro.props;

const externalCasUrls = casUrls.filter((value) =>
  /^\/(?:cas|astro-cas)\/[0-9]+(?:_ads)?_cas\.json(?:\?[^#]+)?$/.test(value),
);
---

{
  externalCasUrls.map((url) => (
    <script src={url} type="application/cas+json"></script>
  ))
}

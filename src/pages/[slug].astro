---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import ContextAd from '../components/ContextAd.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentAttestation from '../components/ContentAttestation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  decodeWordPressSlug,
  getAllPosts,
  getFeaturedImage,
  getPostCategories,
  type WordPressPost,
} from '../lib/wordpress';
import {
  getContextAd,
  type ContextAdPlacement,
} from '../lib/context-ads';
import { stripHtml } from '../lib/text';
import { getArticleContentAttestations } from '../lib/content-attestations';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();

  return posts.map((post) => {
    const categoryId = post.categories[0];
    const relatedPosts = categoryId
      ? posts
          .filter(
            (candidate) =>
              candidate.id !== post.id &&
              candidate.categories.includes(categoryId),
          )
          .slice(0, 3)
      : [];

    return {
      params: {
        slug: decodeWordPressSlug(post.slug),
      },
      props: {
        post,
        relatedPosts,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: WordPressPost;
  relatedPosts: WordPressPost[];
}

const { post, relatedPosts } = Astro.props;
const title = stripHtml(post.title.rendered);
const description =
  stripHtml(post.excerpt.rendered).slice(0, 160) ||
  'JiJi Styleの記事です。';
const featuredImage = getFeaturedImage(post);
const categories = getPostCategories(post).map((category) => ({
  ...category,
  name: stripHtml(category.name),
}));

const formattedDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(post.date));

const decodedSlug = decodeWordPressSlug(post.slug);
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const canonical = siteUrl ? `${siteUrl}/${decodedSlug}/` : undefined;
const imageWidth = featuredImage?.media_details?.width ?? 1600;
const imageHeight = featuredImage?.media_details?.height ?? 1200;
const issuedCas = getArticleContentAttestations(decodedSlug);

type ArticlePart =
  | { type: 'html'; value: string }
  | { type: 'ad'; placement: ContextAdPlacement };

function splitArticleContent(content: string): ArticlePart[] {
  const withMarkers = content
    .replace(
      /<div\b[^>]*\bclass=(["'])[^"']*\bcam-context-ad-slot\b[^"']*\bcam-context-ad-(top|middle|bottom)\b[^"']*\1[^>]*>[\s\S]*?<\/div>\s*<\/div>/gi,
      (_match, _quote, placement: ContextAdPlacement) =>
        `<!-- cam-context-ad:${placement} -->`,
    )
    .replace(
      /<span\b[^>]*\bclass=(["'])[^"']*\bcam-context-(?:bottom-reach|time)-marker\b[^"']*\1[^>]*>[\s\S]*?<\/span>/gi,
      '',
    );

  return withMarkers
    .split(/(<!--\s*cam-context-ad:(?:top|middle|bottom)\s*-->)/i)
    .filter(Boolean)
    .map((part) => {
      const match = part.match(
        /^<!--\s*cam-context-ad:(top|middle|bottom)\s*-->$/i,
      );

      return match
        ? { type: 'ad' as const, placement: match[1] as ContextAdPlacement }
        : { type: 'html' as const, value: part };
    });
}

const articleParts = splitArticleContent(post.content.rendered);
const [topAd, middleAd, bottomAd] = await Promise.all(
  (['top', 'middle', 'bottom'] as const).map((placement) =>
    getContextAd(post.id, placement),
  ),
);
const contextAds = { top: topAd, middle: middleAd, bottom: bottomAd };
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={featuredImage?.source_url}
  type="article"
>
  <article class="py-10 md:py-16 lg:py-20">
    <div class="mx-auto w-full max-w-[900px] px-5 md:px-8">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          ...(categories[0]
            ? [
                {
                  label: categories[0].name,
                  href: `/category/${categories[0].slug}/`,
                },
              ]
            : []),
          { label: title },
        ]}
      />

      <header class="mb-10 mt-8 md:mb-14 md:mt-10">
        {
          categories.length > 0 && (
            <p class="mb-4 flex flex-wrap gap-x-2 text-xs tracking-[0.16em] text-jiji-muted uppercase">
              {categories.map((category, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">/</span>}
                  <a
                    class="transition-opacity hover:opacity-50"
                    href={`/category/${category.slug}/`}
                  >
                    {category.name}
                  </a>
                </>
              ))}
            </p>
          )
        }

        <h1 class="font-serif text-4xl leading-[1.15] font-bold text-balance md:text-5xl lg:text-6xl">
          {title}
        </h1>

        <time
          class="mt-5 block text-sm text-jiji-muted"
          datetime={post.date}
        >
          {formattedDate}
        </time>
      </header>

      {
        featuredImage && (
          <figure class="mb-10 md:mb-14">
            <Image
              class="h-auto w-full"
              src={featuredImage.source_url}
              alt={featuredImage.alt_text || title}
              width={imageWidth}
              height={imageHeight}
              widths={[720, 960, 1280, 1600]}
              sizes="(max-width: 960px) 100vw, 900px"
              format="webp"
              quality={86}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div id="article-content">
        {articleParts.map((part) =>
          part.type === 'ad' ? (
            <ContextAd
              ad={contextAds[part.placement]}
              placement={part.placement}
              postId={post.id}
            />
          ) : (
            <div
              class="wp-content text-[1rem] leading-8 text-neutral-800 md:text-[1.05rem]"
              set:html={part.value}
            />
          ),
        )}
      </div>

      <ContentAttestation cas={issuedCas} />
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="border-t border-jiji-border py-12 md:py-16">
        <div class="mx-auto w-full max-w-[1280px] px-5 md:px-8">
          <p class="mb-2 text-xs tracking-[0.2em] text-jiji-muted uppercase">
            More to Read
          </p>
          <h2 class="font-serif text-3xl font-bold md:text-4xl">関連記事</h2>

          <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 md:mt-10">
            {relatedPosts.map((relatedPost) => <ArticleCard post={relatedPost} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

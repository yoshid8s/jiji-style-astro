---
import '../styles/global.css';
import { createSeo } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image,
  type,
} = Astro.props;

const seo = createSeo({
  title,
  description,
  canonical,
  image,
  type,
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />

    <link rel="canonical" href={seo.canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.image && <meta name="twitter:image" content={seo.image} />}
  </head>

  <body class="min-h-screen bg-white text-jiji-text">
    <header class="border-b border-jiji-border">
      <div class="mx-auto w-full max-w-[1280px] px-5 md:px-8">
        <div class="flex items-end justify-between gap-8 py-7 md:py-10">
          <div>
            <a
              class="inline-block font-serif text-5xl leading-none font-bold no-underline md:text-6xl"
              href="/"
            >
              JiJi Style
            </a>

            <p class="mt-3 text-sm tracking-wide text-jiji-muted md:text-base">
              Enjoy dressing well.
            </p>
          </div>

          <p class="hidden whitespace-nowrap text-right text-xs leading-5 tracking-wide text-jiji-muted lg:block">
            A personal journal about clothing, style and living well.
          </p>
        </div>

        <nav
          class="overflow-x-auto border-t border-jiji-border md:overflow-visible"
          aria-label="メインナビゲーション"
        >
          <ul class="flex min-w-max gap-7 py-4 text-xs tracking-[0.14em] uppercase">
            <li><a class="no-underline hover:opacity-50" href="/">Home</a></li>
            <li>
              <details class="wardrobe-menu">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 hover:opacity-50 [&::-webkit-details-marker]:hidden">
                  Wardrobe
                  <svg
                    class="h-3 w-3 transition-transform duration-200"
                    viewBox="0 0 12 12"
                    aria-hidden="true"
                  >
                    <path
                      d="m2 4 4 4 4-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                    />
                  </svg>
                </summary>

                <ul class="wardrobe-submenu">
                  <li><a href="/category/jackets_suits/">Jackets &amp; Suits</a></li>
                  <li><a href="/category/ties/">Ties</a></li>
                  <li><a href="/category/coats/">Coats</a></li>
                  <li><a href="/category/shoes/">Shoes</a></li>
                  <li><a href="/category/shirts/">Shirts</a></li>
                </ul>
              </details>
            </li>
            <li><a class="no-underline hover:opacity-50" href="/category/daily-style/">Daily Style</a></li>
            <li><a class="no-underline hover:opacity-50" href="/category/classic-menswear/">Classic Menswear</a></li>
            <li><a class="no-underline hover:opacity-50" href="/about/">About</a></li>
            <li><a class="no-underline hover:opacity-50" href="https://jiji-shop.yh-inc.jp/" target="_blank" rel="noreferrer">JiJi Shop</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-jiji-border py-7 text-sm text-jiji-muted">
      <div class="mx-auto w-[min(calc(100%-2.5rem),73.75rem)]">
        <p>© Y&amp;H Inc. All Rights Reserved.</p>
      </div>
    </footer>
  </body>
  <style>
    .wardrobe-menu {
      position: relative;
    }

    .wardrobe-menu > summary {
      align-items: center;
      min-height: 1.25rem;
    }

    .wardrobe-submenu {
      position: absolute;
      z-index: 20;
      top: calc(100% + 1rem);
      left: -1.25rem;
      display: none;
      width: 15rem;
      padding: 0.75rem 1.25rem;
      background: #fff;
      border: 1px solid var(--color-jiji-border);
      box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 0.08);
    }

    .wardrobe-menu:hover > .wardrobe-submenu,
    .wardrobe-menu:focus-within > .wardrobe-submenu,
    .wardrobe-menu[open] > .wardrobe-submenu {
      display: block;
    }

    .wardrobe-menu[open] summary svg {
      transform: rotate(180deg);
    }

    .wardrobe-submenu li + li {
      border-top: 1px dashed #eadfdf;
    }

    .wardrobe-submenu a {
      display: block;
      padding: 1rem 0;
      color: inherit;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
    }

    .wardrobe-submenu a:hover,
    .wardrobe-submenu a:focus-visible {
      color: #cda2a2;
    }

    @media (max-width: 767px) {
      .wardrobe-submenu {
        position: fixed;
        top: auto;
        left: 1rem;
        width: min(15rem, calc(100vw - 2rem));
      }
    }
  </style>
</html>
